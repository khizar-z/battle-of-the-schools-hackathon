{
  "manifest_version": 3,
  "name": "Scout — Secondhand Search",
  "description": "Search secondhand marketplaces in one place.",
  "version": "0.1.0",
  "action": {
    "default_title": "Scout",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*"]
}
