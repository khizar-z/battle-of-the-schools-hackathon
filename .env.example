# Server port used by the local API.
PORT=3000

# Enables deterministic marketplace responses for extension development.
# Set to false once STEEL_API_KEY is configured to use browser sessions.
MOCK_AGENTS=true

# Leave unset to use the deterministic extension demo data. Set this when the
# extension should subscribe to the local Fastify server instead.
# VITE_API_BASE_URL=http://localhost:3000

# Add browser-agent and LLM credentials here when those integrations are added.
# STEEL_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Set to false to force the deterministic parser even when OPENAI_API_KEY exists.
USE_LLM_PARSER=true
# RECIPE_STORE_PATH=./data/site-recipes.json
