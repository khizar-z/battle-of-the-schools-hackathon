# Server port used by the local API.
PORT=3000

# Enables deterministic marketplace responses for extension development.
# Set to false once STEEL_API_KEY is configured to use browser sessions.
MOCK_AGENTS=true

# Leave unset to use the deterministic extension demo data. Set this when the
# extension should subscribe to the local Fastify server instead.
# VITE_API_BASE_URL=http://localhost:3000

# Choose "anthropic" to parse and semantically rank searches with Claude, or
# "openai" for GPT. The model judges broad marketplace candidates after search.
# When omitted, OpenAI is preferred if both keys exist; otherwise the configured
# provider is used. Set to false below to use only the deterministic parser.
LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Browser-agent and optional OpenAI LLM credentials.
# STEEL_API_KEY=
# Reused per-marketplace Steel profile IDs are stored locally here after sign-in.
# STEEL_PROFILE_STORE_PATH=./data/steel-profiles.json
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Set to false to force deterministic parsing and ranking even when an API key exists.
USE_LLM_PARSER=true
# RECIPE_STORE_PATH=./data/site-recipes.json
